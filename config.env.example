# Copie este arquivo para .env e preencha SOMENTE na sua máquina.
# NUNCA versione o .env nem coloque credenciais reais neste arquivo.

# ---- SEI ----
SEI_URL=https://seu-endpoint-do-sei
SEI_USUARIO=seu_usuario
SEI_SENHA=sua_senha

# ---- Jira ----
JIRA_BASE_URL=https://seu-dominio.atlassian.net
JIRA_EMAIL=seu-email
JIRA_API_TOKEN=seu_token

# JQL usada para buscar os cards
JIRA_JQL=project = BOBA AND status IN (BACKLOG, "In Execution")

# ---- Google Drive ----
# Caminho LOCAL da pasta sincronizada do Google Drive.
DRIVE_INDICACOES_ROOT=C:\caminho\para\Indicacoes

# ---- Comportamento ----
HEADLESS=false
MODO_CONFERENCIA=true

# ---- Slack ----
SLACK_WEBHOOK_URL=seu_webhook
